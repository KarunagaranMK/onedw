# ════════════════════════════════════════════════════════════════════
# OneDW — Production Environment Template
# Copy to .env and fill in all values before deploying.
# ALL fields marked [REQUIRED] MUST be set. Never use defaults.
# ════════════════════════════════════════════════════════════════════

# ── MongoDB Atlas ────────────────────────────────────────────────────
# [REQUIRED] Full Atlas connection string
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=onedw_db

# ── JWT Authentication ────────────────────────────────────────────────
# [REQUIRED] Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=REPLACE_WITH_A_STRONG_64_CHAR_HEX_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Gemini AI ────────────────────────────────────────────────────────
# [REQUIRED] Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# ── Application ──────────────────────────────────────────────────────
# [REQUIRED] Must be "production" to enable security checks
APP_ENV=production

# [REQUIRED] Comma-separated list of allowed frontend origins (HTTPS)
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# [RECOMMENDED] Override the admin setup key from the default
ADMIN_SETUP_KEY=REPLACE_WITH_RANDOM_SECRET_KEY

# ── Cloudinary (for media uploads) ───────────────────────────────────
# [OPTIONAL] Only needed if using Cloudinary media uploads
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
